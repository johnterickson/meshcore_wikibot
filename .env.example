ZIM_PATH=D:/wikipedia
KIWIX_PORT=8081
MCP_PORT=8000
OPENZIM_MCP_LOG_LEVEL=INFO
HOME_ASSISTANT_GATEWAY_PORT=11435
HOME_ASSISTANT_CONTROL_GATEWAY_PORT=11436
HOME_ASSISTANT_MODEL=nemotron-3-nano-4b
LM_STUDIO_TEMPERATURE=0.2
LM_STUDIO_MAX_TOKENS=2048
HOME_ASSISTANT_GATEWAY_API_KEY=replace-with-a-random-64-character-hex-value
HOME_ASSISTANT_CONTROL_GATEWAY_API_KEY=replace-with-a-different-random-64-character-hex-value

# Set this only when authentication is enabled in LM Studio itself.
LM_STUDIO_API_KEY=

# Generate each value independently, for example with: openssl rand -hex 32
OPENZIM_MCP_AUTH_TOKEN=replace-with-a-random-64-character-hex-value